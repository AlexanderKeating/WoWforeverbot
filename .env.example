# Required: Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Optional but recommended: dev.twitch.tv/console > Register Your Application
# Without these the bot still posts; it just skips the clips section.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: console.cloud.google.com > enable YouTube Data API v3 > Credentials > API key
# Without it the bot skips the top-video section.
YOUTUBE_API_KEY=

# Where the database lives. On Railway, mount a volume at /data.
DB_PATH=/data/forever.db

# Optional: your server's ID, so slash commands appear instantly while testing
DEV_GUILD_ID=

LOG_LEVEL=INFO
